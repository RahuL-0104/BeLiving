# Copy this file, rename the copy to .env, and paste your keys.

# Main AI and backup AI: openai / gemini / claude
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=gemini

# OpenAI key: https://platform.openai.com/api-keys
OPENAI_API_KEY=paste-your-key-here
OPENAI_MODEL=gpt-5.6-luna

# Gemini key (free): https://aistudio.google.com  -> "Get API key"
GEMINI_API_KEY=paste-your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Only needed if you use claude  (https://console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
