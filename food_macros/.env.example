# Copy to .env and fill in. Only the provider key is required.

# ---- Vision provider -------------------------------------------------------
# gemini (default) or openai
FOOD_PROVIDER=gemini

# Gemini key: https://aistudio.google.com -> Get API key. Turn on billing before launch
# (free tier = 5 requests/minute and the main model is often overloaded for free users).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# OpenAI instead: set FOOD_PROVIDER=openai and a vision-capable model id
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Auth (same as the Meditation service) ---------------------------------
# Shared HS256 secret with BeLiving's login. When set, /api/food/* needs "Authorization: Bearer <JWT>"
# and the user id is the token's `sub` claim.
AUTH_SECRET=
# 1 = accept X-User-Id without a token and show the test page at / (local testing only).
# Leave empty in production (turns off automatically once AUTH_SECRET is set).
ALLOW_ANON=

# Comma-separated sites allowed to call this API from a browser, e.g. https://app.beliving.in
CORS_ORIGINS=

# ---- Limits & tuning -------------------------------------------------------
# scans per user per day (IST), 0 = unlimited
FOOD_DAILY_LIMIT=40
FOOD_MAX_UPLOAD_MB=10
# vision calls in flight per worker
FOOD_MAX_CONCURRENT=8
# per vision call
FOOD_TIMEOUT_S=25
# total per photo including retries
FOOD_DEADLINE_S=60
FOOD_RETRIES=4
# items under this confidence get needs_confirmation=true
FOOD_CONFIRM_BELOW=0.6
# photo is resized to this before upload (cost + speed)
FOOD_MAX_SIDE=1024

HOST=127.0.0.1
PORT=8006
LOG_LEVEL=INFO
